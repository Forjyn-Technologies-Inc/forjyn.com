---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';

const title = 'Forjyn Pricing | Startup and Investor Plans';
const description =
	'Compare Forjyn plans for startups, investors, ecosystem partners, accelerators, universities, and innovation organizations.';

const ecosystemFeatures = [
	'Organization workspace',
	'Startup and investor directories',
	'Referral management',
	'Event management',
	'Program communications',
	'Engagement reporting',
	'Administrative controls',
	'Moderator accounts',
	'AI evaluation management',
	'Compliance workflows',
	'Custom branding',
	'Data exports',
	'Priority support',
];

const enterpriseFeatures = [
	'Custom onboarding',
	'Advanced role permissions',
	'Multiple programs or chapters',
	'Dedicated organization environments',
	'Custom workflows',
	'Integration support',
	'Advanced analytics',
	'Enhanced security configuration',
	'High-volume communications',
	'Increased storage',
	'Dedicated support',
	'Implementation services',
	'Training',
	'Service-level agreements',
];
---

<BaseLayout title={title} description={description}>
	<PageHero
		eyebrow="Pricing"
		title="Choose the Right Forjyn Experience"
		lede="Start with an account or speak with our team about a platform solution tailored to your organization."
	/>

	<section class="border-y border-line bg-midnight section-y">
		<div class="container-page grid gap-6 lg:grid-cols-2">
			<article class="rounded-2xl border border-line bg-graphite p-7 sm:p-8">
				<p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald">Startup</p>
				<h2 class="mt-3 font-display text-2xl font-semibold text-cloud">
					For Founders Building Their Investor Presence
				</h2>
				<p class="mt-3 text-sm leading-relaxed text-slate">
					Build a company profile, upload fundraising materials, access relevant platform tools, and
					connect with investors.
				</p>
				<p class="mt-5 font-display text-lg font-semibold text-cloud">
					100 CAD <span class="text-base font-medium text-slate">per year</span>
				</p>
				<p class="mt-5 text-xs leading-relaxed text-slate">
					Certain premium features, enhanced analytics, evaluations, additional storage, or promotional
					visibility may require a paid subscription.
				</p>
				<a href="https://app.forjyn.com/register" class="btn-primary mt-6">Sign Up as a Startup</a>
			</article>

			<article class="rounded-2xl border border-line bg-graphite p-7 sm:p-8">
				<p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald">Investor</p>
				<h2 class="mt-3 font-display text-2xl font-semibold text-cloud">
					For Investors Seeking Organized, Personalized Deal Flow
				</h2>
				<p class="mt-3 text-sm leading-relaxed text-slate">
					Create your investor profile, define your investment preferences, discover startups, and
					manage your opportunity pipeline.
				</p>
				<p class="mt-5 font-display text-lg font-semibold text-cloud">
					999 CAD <span class="text-base font-medium text-slate">per year</span>
				</p>
				<p class="mt-5 text-xs leading-relaxed text-slate">
					Access to selected opportunities and investment-related features may require successful
					identity, compliance, and accreditation verification.
				</p>
				<a href="https://app.forjyn.com/register" class="btn-primary mt-6">Sign Up as an Investor</a>
			</article>

			<article class="rounded-2xl border border-line bg-graphite p-7 sm:p-8">
				<p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald">Ecosystem</p>
				<h2 class="mt-3 font-display text-2xl font-semibold text-cloud">
					For Organizations Supporting Founders and Investors
				</h2>
				<p class="mt-3 text-sm leading-relaxed text-slate">
					Designed for accelerators, incubators, universities, angel groups, innovation hubs, corporate
					innovation teams, economic development organizations, and other ecosystem partners.
				</p>
				<p class="mt-5 font-display text-lg font-semibold text-cloud">
					1,000 CAD <span class="text-base font-medium text-slate">per year</span>
				</p>
				<ul class="mt-6 space-y-2.5">
					{
						ecosystemFeatures.map((item) => (
							<li class="flex gap-2.5 text-sm text-slate">
								<span class="capability-dot" aria-hidden="true" />
								{item}
							</li>
						))
					}
				</ul>
				<a href="/contact#demo" class="btn-primary mt-6">Book a Demo</a>
			</article>

			<article class="rounded-2xl border border-emerald/25 bg-midnight p-7 text-cloud sm:p-8">
				<p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald">Enterprise</p>
				<h2 class="mt-3 font-display text-2xl font-semibold">For Complex Innovation Networks</h2>
				<p class="mt-3 text-sm leading-relaxed text-slate">
					A tailored platform configuration for organizations with advanced operational, security,
					integration, reporting, or user-management requirements.
				</p>
				<p class="mt-5 font-display text-lg font-semibold text-emerald">Custom</p>
				<ul class="mt-6 space-y-2.5">
					{
						enterpriseFeatures.map((item) => (
							<li class="flex gap-2.5 text-sm text-slate">
								<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald" aria-hidden="true" />
								{item}
							</li>
						))
					}
				</ul>
				<a href="/contact" class="btn-primary-on-dark mt-6">Contact Sales</a>
			</article>
		</div>
	</section>

	<CtaBand
		title="Not Sure Which Plan Fits?"
		lede="Speak with our team about your goals, users, programs, and platform requirements."
	>
		<Fragment slot="actions">
			<a href="/contact#demo" class="btn-primary">Book a Demo</a>
		</Fragment>
	</CtaBand>
</BaseLayout>
