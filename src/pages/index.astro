---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/sections/ComparisonTable.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import {
	homeAiCapabilities,
	homeAudiences,
	homeComparisonColumns,
	homeComparisonRows,
	homeDealPreview,
	homeJourney,
} from '../data/home';
---

<BaseLayout>
	{/* Hero — LCP is the H1; avoid opacity:0 entrance animations on critical text */}
	<section class="relative overflow-hidden bg-midnight text-cloud">
		<div class="pointer-events-none absolute inset-0 bg-hero-glow" aria-hidden="true"></div>
		<div
			class="pointer-events-none absolute inset-0 bg-grid-fade bg-[size:48px_48px] opacity-40 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"
			aria-hidden="true"
		>
		</div>

		<div class="container-page relative grid items-center gap-12 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-16">
			<div>
				<p class="font-display text-sm font-semibold uppercase tracking-[0.22em] text-emerald">
					Forjyn Technologies
				</p>
				<div class="accent-line mt-4 max-w-24"></div>
				<h1 class="mt-5 max-w-xl min-w-0 break-words font-display text-4xl font-bold leading-[1.08] tracking-tight text-cloud sm:text-5xl lg:text-[3.4rem]">
					Intelligent Deal Flow for <span class="text-gradient">Startups &amp; Investors</span>
				</h1>
				<p class="mt-6 max-w-lg text-base leading-relaxed text-slate sm:text-lg">
					Forjyn connects startups, investors, ecosystem partners, and service providers through one
					intelligent technology platform.
				</p>
			</div>

			<div class="relative min-w-0 overflow-hidden" aria-hidden="true">
				<div class="absolute inset-0 rounded-[2rem] bg-emerald/10 blur-2xl"></div>
				<div class="relative overflow-hidden rounded-2xl border border-line bg-graphite/80 p-5 shadow-glow-border backdrop-blur-sm sm:p-6 motion-safe:animate-float">
					<div class="flex items-center justify-between gap-3 border-b border-line pb-4">
						<div class="min-w-0">
							<p class="text-xs font-medium uppercase tracking-[0.16em] text-slate">Deal Flow</p>
							<p class="mt-1 font-display text-lg font-semibold text-cloud">Personalized Discovery</p>
						</div>
						<span class="metric shrink-0 rounded-full bg-emerald/20 px-3 py-1 text-xs font-semibold text-emerald"
							>94% match</span
						>
					</div>
					<div class="mt-5 space-y-3">
						{
							homeDealPreview.map((item) => (
								<div class="flex items-center justify-between gap-3 rounded-xl border border-line bg-midnight px-4 py-3 transition hover:shadow-glow">
									<div class="min-w-0">
										<p class="truncate text-sm font-semibold text-cloud">{item.name}</p>
										<p class="mt-0.5 truncate text-xs text-slate">{item.meta}</p>
									</div>
									<p class="metric shrink-0 text-sm font-semibold text-emerald">{item.score}</p>
								</div>
							))
						}
					</div>
					<div class="mt-5 grid grid-cols-3 gap-1 border-t border-line pt-4 text-center sm:gap-2">
						<div>
							<p class="font-display text-base font-semibold text-cloud sm:text-lg">Match</p>
							<p class="text-[0.65rem] text-slate sm:text-[0.7rem]">Compatibility</p>
						</div>
						<div>
							<p class="font-display text-base font-semibold text-cloud sm:text-lg">Review</p>
							<p class="text-[0.65rem] text-slate sm:text-[0.7rem]">Profiles</p>
						</div>
						<div>
							<p class="font-display text-base font-semibold text-cloud sm:text-lg">Diligence</p>
							<p class="text-[0.65rem] text-slate sm:text-[0.7rem]">Secure rooms</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-midnight pt-14 pb-0 sm:pt-16">
		<div class="container-page">
			<h2 class="section-heading">Innovation Moves Quickly. Your Technology Should Too.</h2>
			<div class="mt-6 space-y-5 text-justify text-base leading-relaxed text-slate sm:text-lg">
				<p>The innovation ecosystem is powerful but it's still fragmented.</p>
				<p>
					Startups, investors, and ecosystem partners rely on disconnected tools, making it harder to
					discover opportunities, manage relationships, and drive growth.
				</p>
				<p>
					<strong class="font-medium text-cloud">Forjyn brings everything together in one platform,</strong>
					{' '}helping startups raise capital, investors manage deal flow, and ecosystem organizations
					support innovation more efficiently.
				</p>
				<p class="font-medium text-cloud">
					Build stronger connections. Make better decisions. Accelerate innovation.
				</p>
			</div>
		</div>
	</section>

	<section class="bg-graphite/50 section-y">
		<div class="container-page">
			<h2 class="section-heading">One Platform. Every Stage of the Opportunity.</h2>
			<p class="section-lede">
				Forjyn supports the journey from initial discovery to deeper evaluation and long-term growth.
			</p>
			<ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
				{
					homeJourney.map((step, index) => (
						<li class="relative">
							<span class="font-display text-sm font-semibold text-emerald">
								{String(index + 1).padStart(2, '0')}
							</span>
							<h3 class="mt-2 font-display text-xl font-semibold text-cloud">{step.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate">{step.body}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="border-y border-line bg-graphite section-y">
		<div class="container-page">
			<h2 class="section-heading">Built for the People Driving Innovation</h2>
			<div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
				{
					homeAudiences.map((item) => (
						<div class="border-t border-line pt-6">
							<h3 class="font-display text-xl font-semibold text-cloud">{item.title}</h3>
							<p class="mt-3 text-sm leading-relaxed text-slate sm:text-base">{item.body}</p>
							<a href={item.href} class="link-accent mt-5 inline-flex text-sm">
								{item.linkLabel}
							</a>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="border-y border-line bg-midnight section-y">
		<div class="container-page">
			<h2 class="section-heading">Intelligence Built Into the Platform</h2>
			<p class="section-lede">
				Advanced artificial intelligence is embedded throughout the Forjyn platform to enhance
				opportunity evaluation, document intelligence, due diligence, and investment workflows. By
				combining intelligent matching, contextual analysis, and automated insights, Forjyn enables
				faster, more informed decision-making while maintaining complete user oversight.
			</p>
			<div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
				{
					homeAiCapabilities.map((item) => (
						<div class="border-t border-line pt-5">
							<h3 class="font-display text-lg font-semibold text-cloud">{item.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate">{item.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<ComparisonTable
		title="How Approaches Compare"
		lede="A concise look at how common deal-flow setups differ on matching, diligence, ecosystem support, and security."
		columns={homeComparisonColumns}
		rows={homeComparisonRows}
		compactTop
	/>

	<CtaBand
		title="Better Connections Create Better Companies"
		lede="Join a platform designed to help startups grow, investors discover opportunities, and innovation communities work together."
	>
		<Fragment slot="actions">
			<a href="https://app.forjyn.com/register" class="btn-primary min-w-[12rem]">Sign Up Now</a>
			<a href="/contact#demo" class="btn-secondary min-w-[12rem]">Book a Demo</a>
		</Fragment>
	</CtaBand>
</BaseLayout>
