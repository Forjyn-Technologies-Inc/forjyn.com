---
import type { MarkdownInstance } from 'astro';
import InfoPage from '../../components/sections/InfoPage.astro';
import { legalPages, getLegalPage } from '../../data/legalPages';

type LegalFrontmatter = {
	title: string;
	seoTitle: string;
	seoDescription: string;
	updated: string;
};

export async function getStaticPaths() {
	const legalModules = import.meta.glob<MarkdownInstance<LegalFrontmatter>>(
		'../../content/legal/*.md',
	);

	return Promise.all(
		legalPages.map(async (page) => {
			const loader = legalModules[`../../content/legal/${page.content}.md`];
			if (!loader) {
				throw new Error(`Missing legal markdown: ${page.content}.md`);
			}
			const mod = await loader();
			return {
				params: { slug: page.slug },
				props: {
					frontmatter: mod.frontmatter,
					Content: mod.Content,
				},
			};
		}),
	);
}

interface Props {
	frontmatter: LegalFrontmatter;
	Content: MarkdownInstance<LegalFrontmatter>['Content'];
}

const { frontmatter, Content } = Astro.props;

if (!getLegalPage(Astro.params.slug ?? '')) {
	throw new Error(`Unknown legal page: ${Astro.params.slug}`);
}
---

<InfoPage
	eyebrow="Legal"
	title={frontmatter.title}
	lede={`Last updated: ${frontmatter.updated}`}
	seoTitle={frontmatter.seoTitle}
	seoDescription={frontmatter.seoDescription}
>
	<div class="legal-doc">
		<Content />
	</div>
	<p class="pt-4 text-sm text-slate">
		Questions?{' '}
		<a href="/contact">Contact Forjyn</a>
		{' '}or email{' '}
		<a href="mailto:legal@forjyn.com">legal@forjyn.com</a>.
	</p>
</InfoPage>
