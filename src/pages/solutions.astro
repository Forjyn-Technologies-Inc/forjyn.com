---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import {
	startupProfileAreas,
	matchingAreas,
	startupMetrics,
	investorPreferences,
	discoveryActions,
	profileReviewAreas,
	pipelineStages,
	verificationSteps,
	eventTypes,
	ecosystemMetrics,
	serviceCategories,
} from '../data/solutions';

const title = 'Forjyn Solutions for Startups & Investors';
const description =
	'Explore Forjyn solutions for startup fundraising, investor deal discovery, due diligence, ecosystem management, and intelligent matching.';

const audienceLabel =
	'font-display text-sm font-semibold uppercase tracking-[0.18em] text-emerald sm:text-base';

/** Roomier two-column lists — avoids cramped nested columns inside feature blocks. */
const featureList = 'mt-6 grid gap-x-12 gap-y-3 sm:grid-cols-2';
const featureItem = 'flex gap-3 text-base leading-snug text-slate';
---

<BaseLayout title={title} description={description}>
	<PageHero
		eyebrow="Solutions"
		title="Technology Built Around the People Driving Innovation"
		lede="Forjyn gives startups, investors, and ecosystem partners distinct tools while connecting them through one shared platform."
	>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
			<a href="/contact#demo" class="btn-primary">Book a Demo</a>
		</div>
		<nav
			class="mt-8 flex flex-wrap items-center justify-center gap-3"
			aria-label="Solutions sections"
		>
			<a href="#startups" class="btn-secondary">Startups</a>
			<a href="#investors" class="btn-secondary">Investors</a>
			<a href="#ecosystem" class="btn-secondary">Ecosystem Partners</a>
			<a href="#service-providers" class="btn-secondary">Service Providers</a>
		</nav>
	</PageHero>

	<section id="startups" class="scroll-mt-24 bg-graphite section-y">
		<div class="container-page">
			<p class={audienceLabel}>For Startups</p>
			<div class="accent-line mt-4 max-w-20"></div>
			<h2 class="section-heading mt-5">Build, Present and Grow Your Company</h2>
			<div class="mt-6 space-y-4 text-justify text-base leading-relaxed text-slate">
				<p>
					Fundraising can be difficult to navigate. Founders are often asked to recreate the same
					company information across different applications, investor introductions, pitch events,
					data rooms, and due diligence requests.
				</p>
				<p>
					Forjyn gives startups one centralized environment to organize their company information,
					showcase their opportunity, understand investor engagement, and manage the path toward
					investment.
				</p>
			</div>

			<div class="mt-14 divide-y divide-line border-y border-line">
				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Create an Investor-Ready Profile
					</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						Build a structured company profile that helps investors understand your opportunity.
					</p>
					<ul class={featureList}>
						{
							startupProfileAreas.map((item) => (
								<li class={featureItem}>
									<span class="capability-dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Receive AI-Supported Feedback
					</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						Forjyn’s evaluation tools review available profile information and provide structured
						insights that can help founders identify missing information, inconsistencies, and areas
						requiring clarification. Founders can follow evaluation progress and improve their
						profiles over time.
					</p>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Get Discovered by Relevant Investors
					</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						Matching considers the preferences that matter most to both sides of the deal.
					</p>
					<ul class={featureList}>
						{
							matchingAreas.map((item) => (
								<li class={featureItem}>
									<span class="capability-dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Understand Investor Engagement
					</h3>
					<ul class={featureList}>
						{
							startupMetrics.map((item) => (
								<li class={featureItem}>
									<span class="capability-dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Manage Due Diligence
					</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						When an investor relationship progresses, founders can access a secure due diligence room.
						Upload requested information, respond to document checklists, track requirements, and keep
						the process organized.
					</p>
				</article>
			</div>

			<div class="mt-14 text-center">
				<p class="font-display text-2xl font-semibold text-cloud sm:text-3xl">
					Ready to Build Your Investor Presence?
				</p>
				<p class="mt-3 text-base leading-relaxed text-slate">
					Create your Forjyn account and start building your company profile.
				</p>
				<div class="mt-6 flex justify-center">
					<a href="https://app.forjyn.com/register" class="btn-primary">Sign Up as a Startup</a>
				</div>
			</div>
		</div>
	</section>

	<section id="investors" class="scroll-mt-24 border-y border-line bg-midnight section-y">
		<div class="container-page">
			<p class={audienceLabel}>For Investors</p>
			<div class="accent-line mt-4 max-w-20"></div>
			<h2 class="section-heading mt-5">Discover Opportunities That Match Your Thesis</h2>
			<div class="mt-6 space-y-4 text-justify text-base leading-relaxed text-slate">
				<p>
					Investors need quality deal flow, but more opportunities do not always lead to better
					decisions.
				</p>
				<p>
					Forjyn helps investors personalize discovery, compare opportunities, organize deal
					activity, and collaborate throughout the investment review process.
				</p>
			</div>

			<div class="mt-14 divide-y divide-line border-y border-line">
				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Personalized Deal Discovery
					</h3>
					<ul class={featureList}>
						{
							investorPreferences.map((item) => (
								<li class={featureItem}>
									<span class="capability-dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Mobile-First Discovery
					</h3>
					<ul class={featureList}>
						{
							discoveryActions.map((item) => (
								<li class={featureItem}>
									<span class="capability-dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Compatibility Scoring
					</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						Forjyn can calculate a 0–100 compatibility score based on relevant startup and investor
						information. The score is designed to help investors organize opportunities and identify
						possible alignment. It is not a recommendation or guarantee of investment suitability.
					</p>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Detailed Company Profiles
					</h3>
					<ul class={featureList}>
						{
							profileReviewAreas.map((item) => (
								<li class={featureItem}>
									<span class="capability-dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Organize Your Deal Pipeline
					</h3>
					<ul class={featureList}>
						{
							pipelineStages.map((item) => (
								<li class={featureItem}>
									<span class="capability-dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Collaborate During Due Diligence
					</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						Use secure rooms to review documents, coordinate questions, share notes, and monitor
						outstanding information.
					</p>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Track Commitments and Portfolio Activity
					</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						Record investment interest, pledged amounts, completed investments, and the status of
						portfolio opportunities.
					</p>
				</article>

				<article class="py-8">
					<h3 class="font-display text-xl font-semibold text-cloud sm:text-2xl">
						Investor Verification
					</h3>
					<ul class={featureList}>
						{
							verificationSteps.map((item) => (
								<li class={featureItem}>
									<span class="capability-dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</article>
			</div>

			<div class="mt-14 text-center">
				<p class="font-display text-2xl font-semibold text-cloud sm:text-3xl">
					Find Your Next Opportunity
				</p>
				<p class="mt-3 text-base leading-relaxed text-slate">
					Join Forjyn to build a more personalized and organized deal flow experience.
				</p>
				<div class="mt-6 flex justify-center">
					<a href="https://app.forjyn.com/register" class="btn-primary">Sign Up as an Investor</a>
				</div>
			</div>
		</div>
	</section>

	<section id="ecosystem" class="scroll-mt-24 bg-midnight section-y text-cloud">
		<div class="container-page">
			<p class={audienceLabel}>For Ecosystem Partners</p>
			<div class="accent-line mt-4 max-w-20"></div>
			<h2 class="section-heading mt-5">
				Give Your Innovation Community Better Infrastructure
			</h2>
			<p class="mt-5 text-base leading-relaxed text-slate">
				Forjyn helps incubators, accelerators, angel groups, universities, economic development
				organizations, corporate innovation teams, and other ecosystem partners manage startup
				activity from a centralized platform.
			</p>

			<div class="mt-14 divide-y divide-line border-y border-line">
				<article class="py-8">
					<h3 class="font-display text-xl font-semibold sm:text-2xl">Manage Your Startup Community</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						View, organize, and support participating startups through structured profiles and program
						information.
					</p>
				</article>
				<article class="py-8">
					<h3 class="font-display text-xl font-semibold sm:text-2xl">Facilitate Referrals</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						Refer startups to investors, programs, service providers, events, or other ecosystem
						opportunities.
					</p>
				</article>
				<article class="py-8">
					<h3 class="font-display text-xl font-semibold sm:text-2xl">Coordinate Events</h3>
					<ul class={featureList}>
						{
							eventTypes.map((item) => (
								<li class={featureItem}>
									<span class="capability-dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</article>
				<article class="py-8">
					<h3 class="font-display text-xl font-semibold sm:text-2xl">
						Communicate With Stakeholders
					</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						Use targeted email campaigns, transactional messages, in-app notifications, and platform
						announcements to keep members informed.
					</p>
				</article>
				<article class="py-8">
					<h3 class="font-display text-xl font-semibold sm:text-2xl">Measure Engagement</h3>
					<ul class={featureList}>
						{
							ecosystemMetrics.map((item) => (
								<li class={featureItem}>
									<span class="capability-dot" aria-hidden="true" />
									{item}
								</li>
							))
						}
					</ul>
				</article>
				<article class="py-8">
					<h3 class="font-display text-xl font-semibold sm:text-2xl">
						Manage Access and Permissions
					</h3>
					<p class="mt-3 text-base leading-relaxed text-slate">
						Assign administrator, moderator, or program-specific permissions without giving every team
						member full platform access.
					</p>
				</article>
			</div>

			<div class="mt-14 text-center">
				<p class="font-display text-2xl font-semibold text-cloud sm:text-3xl">
					Ready to Manage Your Organization?
				</p>
				<p class="mt-3 text-base leading-relaxed text-slate">
					Join Forjyn to support startups, coordinate programs, and strengthen your innovation community.
				</p>
				<div class="mt-6 flex justify-center">
					<a href="https://app.forjyn.com/register" class="btn-primary">Sign Up as an Ecosystem Partner</a>
				</div>
			</div>
		</div>
	</section>

	<section id="service-providers" class="scroll-mt-24 bg-graphite section-y">
		<div class="container-page">
			<p class={audienceLabel}>For Service Providers</p>
			<div class="accent-line mt-4 max-w-20"></div>
			<h2 class="section-heading mt-5">Reach Startups When Your Expertise Matters Most</h2>
			<div class="mt-6 space-y-4 text-justify text-base leading-relaxed text-slate">
				<p>
					Service providers play an important role in helping startups move from early development to
					sustainable growth. Forjyn can create opportunities for qualified providers to connect with
					startups seeking support.
				</p>
			</div>
			<ul class={"mt-10 " + featureList}>
				{
					serviceCategories.map((item) => (
						<li class={featureItem}>
							<span class="capability-dot" aria-hidden="true" />
							{item}
						</li>
					))
				}
			</ul>
			<p class="mt-8 text-sm leading-relaxed text-slate">
				Service provider participation, visibility, and access may be subject to platform approval or
				partnership arrangements.
			</p>
		</div>
	</section>

	<CtaBand
		title="One Platform. Different Roles. Shared Growth."
		lede="Every Forjyn experience is designed around the user while contributing to a stronger, more connected innovation ecosystem."
	>
		<Fragment slot="actions">
			<a href="https://app.forjyn.com/register" class="btn-primary">Sign Up Now</a>
		</Fragment>
	</CtaBand>
</BaseLayout>
