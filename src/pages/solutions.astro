---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import CapabilityList from '../components/sections/CapabilityList.astro';
import {
	startupFounderFeatures,
	investorFeatures,
	ecosystemPartnerFeatures,
	serviceCategories,
} from '../data/solutions';

const title = 'Forjyn Solutions for Startups & Investors';
const description =
	'Explore Forjyn solutions for startup fundraising, investor deal discovery, due diligence, ecosystem management, and intelligent matching.';

const audienceLabel =
	'font-display text-sm font-semibold uppercase tracking-[0.18em] text-emerald sm:text-base';

/** Roomier two-column lists — avoids cramped nested columns inside feature blocks. */
const featureList = 'mt-6 grid gap-x-12 gap-y-3 sm:grid-cols-2';
const featureItem = 'flex gap-3 text-base leading-snug text-slate';
---

<BaseLayout title={title} description={description}>
	<PageHero
		eyebrow="Solutions"
		title="Technology Built Around the People Driving Innovation"
		lede="Forjyn gives startups, investors, and ecosystem partners distinct tools while connecting them through one shared platform."
		class="[&_.container-page]:pb-8 [&_.container-page]:sm:pb-10 [&_.container-page]:lg:pb-12"
	>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
			<a href="/contact#demo" class="btn-primary">Book a Demo</a>
		</div>
		<nav
			class="mt-5 flex flex-wrap items-center justify-center gap-3"
			aria-label="Solutions sections"
		>
			<a href="#startups" class="btn-secondary text-emerald hover:text-emerald">Startups</a>
			<a href="#investors" class="btn-secondary text-emerald hover:text-emerald">Investors</a>
			<a href="#ecosystem" class="btn-secondary text-emerald hover:text-emerald">Ecosystem Partners</a>
			<a href="#service-providers" class="btn-secondary text-emerald hover:text-emerald"
				>Service Providers</a
			>
		</nav>
	</PageHero>

	<section id="startups" class="scroll-mt-24 bg-graphite pt-8 pb-12 sm:pt-10 sm:pb-16">
		<div class="container-page">
			<p class={audienceLabel}>For Startups</p>
			<div class="accent-line mt-4 max-w-20"></div>
			<h2 class="section-heading mt-5">Features for Startup Founders</h2>
			<p class="mt-6 text-base leading-relaxed text-slate sm:text-lg">
				Build a structured company profile that helps investors understand your opportunity with our
				built in features:
			</p>
			<CapabilityList items={startupFounderFeatures} class="mt-6 gap-x-12 [&_li]:text-base [&_li]:leading-snug" />

			<div class="mt-14 text-center">
				<p class="font-display text-2xl font-semibold text-cloud sm:text-3xl">
					Ready to Build Your Investor Presence?
				</p>
				<p class="mt-3 text-base leading-relaxed text-slate">
					Create your Forjyn account and start building your company profile.
				</p>
				<div class="mt-6 flex justify-center">
					<a href="https://app.forjyn.com/register" class="btn-primary">Sign Up as a Startup</a>
				</div>
			</div>
		</div>
	</section>

	<section id="investors" class="scroll-mt-24 border-y border-line bg-midnight section-y">
		<div class="container-page">
			<p class={audienceLabel}>For Investors</p>
			<div class="accent-line mt-4 max-w-20"></div>
			<h2 class="section-heading mt-5">Features for Investors</h2>
			<p class="mt-6 text-base leading-relaxed text-slate sm:text-lg">
				Discover Opportunities That Match Your Thesis with our built in investor features:
			</p>
			<ul class={featureList}>
				{
					investorFeatures.map((item) => (
						<li class={featureItem}>
							<span class="capability-dot" aria-hidden="true" />
							{item}
						</li>
					))
				}
			</ul>

			<div class="mt-14 text-center">
				<p class="font-display text-2xl font-semibold text-cloud sm:text-3xl">
					Find Your Next Opportunity
				</p>
				<p class="mt-3 text-base leading-relaxed text-slate">
					Join Forjyn to build a more personalized and organized deal flow experience.
				</p>
				<div class="mt-6 flex justify-center">
					<a href="https://app.forjyn.com/register" class="btn-primary">Sign Up as an Investor</a>
				</div>
			</div>
		</div>
	</section>

	<section id="ecosystem" class="scroll-mt-24 bg-midnight section-y text-cloud">
		<div class="container-page">
			<p class={audienceLabel}>For Ecosystem Partners</p>
			<div class="accent-line mt-4 max-w-20"></div>
			<h2 class="section-heading mt-5">Features for Ecosystem Partners</h2>
			<p class="mt-6 text-base leading-relaxed text-slate sm:text-lg">
				Give Your Innovation Community Better Infrastructure with Forjyn’s ecosystem partner features:
			</p>
			<CapabilityList
				items={ecosystemPartnerFeatures}
				class="mt-6 gap-x-12 [&_li]:text-base [&_li]:leading-snug"
			/>

			<div class="mt-14 text-center">
				<p class="font-display text-2xl font-semibold text-cloud sm:text-3xl">
					Ready to Manage Your Organization?
				</p>
				<p class="mt-3 text-base leading-relaxed text-slate">
					Join Forjyn to support startups, coordinate programs, and strengthen your innovation community.
				</p>
				<div class="mt-6 flex justify-center">
					<a href="https://app.forjyn.com/register" class="btn-primary">Sign Up as an Ecosystem Partner</a>
				</div>
			</div>
		</div>
	</section>

	<section id="service-providers" class="scroll-mt-24 bg-graphite section-y">
		<div class="container-page">
			<p class={audienceLabel}>For Service Providers</p>
			<div class="accent-line mt-4 max-w-20"></div>
			<h2 class="section-heading mt-5">Reach Startups When Your Expertise Matters Most</h2>
			<div class="mt-6 space-y-4 text-justify text-base leading-relaxed text-slate">
				<p>
					Service providers play an important role in helping startups move from early development to
					sustainable growth. Forjyn can create opportunities for qualified providers to connect with
					startups seeking support.
				</p>
			</div>
			<ul class={"mt-10 " + featureList}>
				{
					serviceCategories.map((item) => (
						<li class={featureItem}>
							<span class="capability-dot" aria-hidden="true" />
							{item}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<CtaBand title="One Platform. Different Roles. Shared Growth.">
		<Fragment slot="actions">
			<a href="https://app.forjyn.com/register" class="btn-primary">Sign Up Now</a>
		</Fragment>
	</CtaBand>
</BaseLayout>
