---
/**
 * Legacy audience URLs redirect to the matching section on /solutions.
 * Hash fragments are applied client-side (HTTP redirects cannot carry them).
 */
export function getStaticPaths() {
	const audienceRedirects = [
		{ slug: 'startups', anchor: 'startups' },
		{ slug: 'investors', anchor: 'investors' },
		{ slug: 'ecosystem', anchor: 'ecosystem' },
		{ slug: 'service-providers', anchor: 'service-providers' },
		{ slug: 'enterprise', anchor: 'ecosystem' },
	] as const;

	return audienceRedirects.map(({ slug, anchor }) => ({
		params: { audience: slug },
		props: { anchor },
	}));
}

interface Props {
	anchor: string;
}

const { anchor } = Astro.props;
const target = `/solutions#${anchor}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href="https://forjyn.com/solutions" />
		<title>Redirecting…</title>
		<script define:vars={{ target }}>
			location.replace(target);
		</script>
	</head>
	<body>
		<p>
			<a href={target}>Continue to Solutions</a>
		</p>
	</body>
</html>
