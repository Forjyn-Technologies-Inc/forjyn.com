---
interface Props {
	/** Small uppercase label above the title. */
	eyebrow?: string;
	/** Primary H1. */
	title: string;
	/** Supporting paragraph. */
	lede?: string;
	/** Optional class on the text column (defaults to full container width). */
	innerClass?: string;
}

const { eyebrow, title, lede, innerClass } = Astro.props;
---

<section class="page-hero">
	<div class="pointer-events-none absolute inset-0 bg-hero-glow" aria-hidden="true"></div>
	<div class="container-page relative py-12 sm:py-16 lg:py-20">
		<div class={innerClass}>
			{
				eyebrow && (
					<p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald">{eyebrow}</p>
				)
			}
			{eyebrow && <div class="accent-line mt-4 max-w-24" />}
			<h1 class="mt-4 min-w-0 break-words font-display text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
			{
				lede && (
					<p class="mt-5 text-justify text-base leading-relaxed text-slate sm:text-lg">{lede}</p>
				)
			}
			{
				Astro.slots.has('actions') && (
					<div class="mt-8 flex flex-wrap gap-3">
						<slot name="actions" />
					</div>
				)
			}
			<slot />
		</div>
	</div>
</section>
